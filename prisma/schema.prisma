generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Item {
  id        String   @id @default(cuid())
  name      String
  brand     String?
  category  String   // MENS_CLOTHING | PERFUME | ELECTRONICS | SHOES | ACCESSORIES | OTHER
  condition String   // NEW_WITH_TAGS | LIKE_NEW | GOOD | FAIR | POOR
  buyPrice  Float
  buyDate   DateTime @default(now())
  notes     String?
  imageUrl  String?
  status    String   @default("BOUGHT") // BOUGHT | LISTED | SOLD | ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing?
  sale    Sale?

  @@index([status])
  @@index([category])
}

model Listing {
  id           String   @id @default(cuid())
  itemId       String   @unique
  listingPrice Float
  listingDate  DateTime @default(now())
  listingUrl   String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Sale {
  id           String   @id @default(cuid())
  itemId       String   @unique
  salePrice    Float
  saleDate     DateTime @default(now())
  platformFee  Float    @default(0)
  shippingCost Float    @default(0)
  profit       Float

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WatchlistItem {
  id        String   @id @default(cuid())
  keywords  String
  category  String
  maxPrice  Float
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
}
